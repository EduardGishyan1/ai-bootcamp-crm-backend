datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Lead {
  id          String  @id @default(uuid())
  fullName    String
  email       String
  phone       String?
  country     String?
  whyApplying String

  stage Stage @default(New)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([email])
}

model Message {
  id        String   @id @default(uuid())
  leadId    String?
  type      String
  payload   Json
  createdAt DateTime @default(now())

  lead Lead? @relation(fields: [leadId], references: [id])

  @@index([leadId])
}

enum Stage {
  New
  Ready
  Paid
  Scheduled
}

model FaqSession {
  id        String   @id @default(uuid())
  leadId    String?               // optional, if you link to Lead
  summary   String?               // short admin-facing title/summary
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  turns     FaqTurn[]


  @@index([leadId])
}

model FaqTurn {
  id         String    @id @default(uuid())
  sessionId  String
  question   String
  answer     String
  topic      String?
  confidence Float
  escalated  Boolean   @default(false)
  createdAt  DateTime  @default(now())

  session    FaqSession @relation(fields: [sessionId], references: [id])
}
